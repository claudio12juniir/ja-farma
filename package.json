{
  "name": "ja-farma",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "openai": "^6.15.0",
    "pdfjs-dist": "^4.0.379",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0"
  },
  "build": {
    "appId": "com.jafarma.sistema",
    "productName": "J.A Produtos Farmacêuticos",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "index.html",
      "style.css",
      "img/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "claudio12juniir",
      "repo": "ja-farma"
    }
  }
}
